# OKX API credentials.
# Demo: switch OKX to Demo Trading and create keys there (mode: demo).
# Live: create keys with Read + Trade permissions ONLY (never Withdraw),
#       bound to your server's IP (mode: live).
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# LLM: fill in the key for the provider set in config.yaml (llm.provider).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Only needed when an OpenAI-compatible model is served by someone other than
# OpenAI - Azure AI Foundry, for example. Leave it commented out for
# api.openai.com. It must end in /v1 (Azure AI Foundry uses /openai/v1), and
# OPENAI_API_KEY above then holds that gateway's key rather than an sk-... one.
# `python main.py check` prints the endpoint it resolved, so a typo is visible
# immediately instead of failing later at the first cycle.
# OPENAI_BASE_URL=https://YOUR-RESOURCE.services.ai.azure.com/openai/v1

# Optional in demo; mandatory before changing config.yaml to mode: live.
# Supports generic JSON, Slack, or Discord payloads (set alerts.format).
ALERT_WEBHOOK_URL=
