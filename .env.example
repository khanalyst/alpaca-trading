# Alpaca paper credentials. Never commit a populated copy of this file.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
ALPACA_LIVE_ENABLE=false

# Free Basic ships with IEX equities and no option acquisition.  Indicative
# options are non-executable and remain disabled while the universe is equity-only.
# Opt into options only after configuring OPRA and an option universe explicitly.
ALPACA_DATA_FEED=iex
ALPACA_STOCK_FEED=iex
ALPACA_OPTIONS_FEED=indicative

# Compose/systemd deployment overrides (leave unset for local defaults).
ALPACA_AGENT_SECRET_FILE=
# Optional host path to a separate research-only dotenv file containing an
# OPENAI_API_KEY or ANTHROPIC_API_KEY. Never put those keys in this broker file.
ALPACA_RESEARCH_LLM_SECRET_FILE=
# The shipped research lane is autonomous and requires this separate readable
# dotenv file to contain OPENAI_API_KEY (or the matching configured provider
# key). An empty or unreadable path must fail closed; never put provider keys in
# this broker secret.
# The shipped research lane follows the equity/shares profile. Set to all or
# option only as an explicit reviewed OPRA research decision.
ALPACA_RESEARCH_VEHICLES=equity
ALPACA_AGENT_IMAGE_TAG=local
ALPACA_PYTHON_IMAGE=python:3.13.5-slim-bookworm
ALPACA_RECORDER_INTERVAL_SECONDS=60
# Bound each recorder bars/quotes catch-up request after an outage. Smaller
# windows use less memory; the one-minute default bounds peak memory at the
# cost of more API requests and slower stale-corpus catch-up.
ALPACA_RECORDER_FETCH_WINDOW_MINUTES=1
# Missing one-minute bars are recorded as coverage evidence by default because
# a selected feed may be sparse. This threshold classifies an observed gap;
# list comma-separated feeds here only when the operator requires fail-closed
# continuity for that feed (for example, iex). Use * to make every feed strict.
ALPACA_RECORDER_BAR_GAP_MINUTES=5
ALPACA_RECORDER_STRICT_BAR_FEEDS=
# Option-chain sampling. The recorder keeps quoting a contract it has already
# sampled for the hold window, so a simulated trade does not lose its contract.
ALPACA_RECORDER_OPTION_LIMIT=10
ALPACA_RECORDER_OPTION_HOLD_MINUTES=180
ALPACA_RESEARCH_TIMEOUT_SECONDS=14400
ALPACA_DASHBOARD_PORT=8080
ALPACA_EXTERNAL_BACKUP_PATH=
ALPACA_RESEARCH_DATASET=
# Limit a research cycle to the most recent N session partitions; 0 uses the
# whole corpus. Research memory tracks this window rather than the corpus.
ALPACA_RESEARCH_SESSION_WINDOW=0
ALPACA_RESEARCH_BACKTEST=1
# Parallel autonomous strategy factory. Defaults cover all eleven bounded rule
# families, four isolated variant accounts per hypothesis, with two workers.
ALPACA_FACTORY_ENABLED=1
ALPACA_FACTORY_STRATEGIES=11
ALPACA_FACTORY_VARIANTS=4
ALPACA_FACTORY_WORKERS=2
ALPACA_FACTORY_STARTING_CASH=100000
ALPACA_FACTORY_MIN_TRADES=100
# Immutable authorizing floors: backtest/factory and qualification require
# 100 trades + 30 complete sessions/clusters; live shadow requires 150 trades
# + 30 complete sessions. Environment values cannot lower these floors.
ALPACA_FACTORY_MIN_SESSIONS=30
ALPACA_FACTORY_ALPHA=0.05
ALPACA_FACTORY_MAX_GENERATIONS=5
# Research can be memory-heavy; keep this below the VM's physical memory so
# trader/recorder/watchdog remain protected. Override per host when needed.
ALPACA_RESEARCH_MEMORY_LIMIT=10g
# Judge demo-account trials before each cycle proposes anything new, so a trial
# that just closed below its floor is already a lesson. The window and the
# floor live in config.yaml under research.trial. A pinned edge is never judged.
ALPACA_TRIAL_REVIEW_ENABLED=1
# Live-shadow authorization needs a genuinely forward sample, separately from
# the factory's development floor.
ALPACA_SHADOW_MIN_TRADES=150
ALPACA_SHADOW_MIN_SESSIONS=30
# Shadow validates and compacts bounded CSV batches in memory. Two gigabytes
# keeps Python row expansion inside the container instead of OOM-restarting.
ALPACA_SHADOW_MEMORY_LIMIT=2g
# Epoch 3 also requires a 30 bps stop floor, cost-covered risk units, and
# quote/snapshot fill quality before evidence can authorize the paper trader.
# Shipped expected costs are 4 bps spread / 6 bps slippage / 0.5 bps fee,
# plus a 0.65 currency-unit option fee per contract per side. Preregistered stress is
# 9/15/25/50 bps; 25 bps is the authorization scenario.
# Where the discovery narrative is archived; the dashboard lists this tree.
ALPACA_RESEARCH_REPORT_DIR=
# Optional edge-lab ledger override; default is runtime/research/edge_lab.sqlite3.
ALPACA_EDGE_DB=
# Flatten-only watchdog. It acts when the trader heartbeat is stale and the
# broker still reports exposure; a living trader holds the run lock and keeps
# it inert. It cannot help if the broker or network is unreachable.
ALPACA_WATCHDOG_INTERVAL_SECONDS=30
ALPACA_WATCHDOG_MAX_HEARTBEAT_AGE=300
