# Alpaca paper credentials. Never commit a populated copy of this file.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# Market-data entitlements. IEX is the conservative stock-feed default.
ALPACA_DATA_FEED=iex
ALPACA_STOCK_FEED=iex
ALPACA_OPTIONS_FEED=indicative

# LLM use is disabled by default; these are needed only when llm.enabled=true.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Compose/systemd deployment overrides (leave unset for local defaults).
ALPACA_AGENT_SECRET_FILE=
ALPACA_AGENT_IMAGE_TAG=local
ALPACA_PYTHON_IMAGE=python:3.13.5-slim-bookworm
ALPACA_RECORDER_INTERVAL_SECONDS=60
ALPACA_RESEARCH_TIMEOUT_SECONDS=14400
ALPACA_DASHBOARD_PORT=8080
ALPACA_EXTERNAL_BACKUP_PATH=
ALPACA_RESEARCH_DATASET=
ALPACA_RESEARCH_BACKTEST=1
# Parallel autonomous strategy factory. Defaults evaluate seven hypotheses,
# four isolated variant accounts per hypothesis, with seven workers.
ALPACA_FACTORY_ENABLED=1
ALPACA_FACTORY_STRATEGIES=7
ALPACA_FACTORY_VARIANTS=4
ALPACA_FACTORY_WORKERS=7
ALPACA_FACTORY_STARTING_CASH=100000
ALPACA_FACTORY_MIN_TRADES=100
ALPACA_FACTORY_MIN_SESSIONS=10
ALPACA_FACTORY_ALPHA=0.05
ALPACA_FACTORY_MAX_GENERATIONS=5
# Optional edge-lab ledger override; default is runtime/research/edge_lab.sqlite3.
ALPACA_EDGE_DB=
