# Alpaca paper credentials. Never commit a populated copy of this file.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# Market-data entitlements. IEX is the conservative stock-feed default.
ALPACA_DATA_FEED=iex
ALPACA_STOCK_FEED=iex
ALPACA_OPTIONS_FEED=indicative

# Optional model credentials for explicitly enabled research/analyst features.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Optional generic/Slack/Discord alert destination.
ALERT_WEBHOOK_URL=

# Compose/systemd deployment overrides (leave unset for local defaults).
ALPACA_AGENT_SECRET_FILE=
ALPACA_AGENT_IMAGE_TAG=local
ALPACA_PYTHON_IMAGE=python:3.13.5-slim-bookworm
ALPACA_RECORDER_INTERVAL_SECONDS=60
ALPACA_RESEARCH_TIMEOUT_SECONDS=14400
ALPACA_DASHBOARD_PORT=8080
ALPACA_EXTERNAL_BACKUP_PATH=
ALPACA_RESEARCH_DATASET=
ALPACA_RESEARCH_BACKTEST=1
