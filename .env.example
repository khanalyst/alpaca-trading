# OKX API credentials.
# Demo: switch OKX to Demo Trading and create keys there (mode: demo).
# Live: create keys with Read + Trade permissions ONLY (never Withdraw),
#       bound to your server's IP (mode: live).
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# LLM: fill in the key for the provider set in config.yaml (llm.provider).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional in demo; mandatory before changing config.yaml to mode: live.
# Supports generic JSON, Slack, or Discord payloads (set alerts.format).
ALERT_WEBHOOK_URL=
