.env
# Separate research provider dotenv. Compose requires a readable path
# here, so the file is easy to create in the workspace by accident.
research-llm.env
runtime/

# Agent tooling scratch: throwaway git worktrees, not project content.
.claude/worktrees/
__pycache__/
*.pyc
.DS_Store
.venv/
venv/

# Generated research caches: binary, large, and rebuildable from the journal.
research/cache/
research/results/edges/
# The discovery narrative is a view over the ledgers, rewritten every cycle.
research/results/factory/

# Imported VM databases/results are audit fixtures only; production and test
# code must use explicit temporary stores or configured runtime paths.
vm-import/
