# Copy to /etc/alpaca-agent-trading/agent.env, chmod 0400, and chown it to
# the restricted alpaca service user. Never commit populated credentials.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
ALPACA_LIVE_ENABLE=false
ALPACA_DATA_FEED=iex
ALPACA_STOCK_FEED=iex
ALPACA_OPTIONS_FEED=indicative
