# Copy to /etc/alpaca-agent-trading/research-llm.env, chmod 0400, and chown
# it to alpaca. Provide the key for the provider selected in config.yaml.
# The research service fails closed when this separate readable file is absent,
# unreadable, or missing the selected provider key. Never put these keys in
# agent.env or .env.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
