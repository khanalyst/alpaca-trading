# OKX does not provide historical order-book depth; start the recorder first.
[Unit]
Description=OKX market-data recorder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=okx
WorkingDirectory=/opt/okx-agent-crypto
ExecStart=/opt/okx-agent-crypto/.venv/bin/python /opt/okx-agent-crypto/research/record_flow.py \
  --out /opt/okx-agent-crypto/runtime/research/recorded
Restart=always
RestartSec=60
StandardOutput=journal
StandardError=journal
TimeoutStopSec=45s

[Install]
WantedBy=multi-user.target
