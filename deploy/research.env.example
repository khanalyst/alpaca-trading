# Copy to /etc/alpaca-agent-trading/research.env and keep it separate from
# agent.env. Research is paper/broker-free and follows the deployed equity lane
# by default. Set this to all (or option) to opt into another research lane.
ALPACA_PAPER=true
ALPACA_LIVE_ENABLE=false
ALPACA_DATA_FEED=iex
ALPACA_STOCK_FEED=iex
ALPACA_OPTIONS_FEED=indicative
ALPACA_RESEARCH_VEHICLES=equity
# Set only for a sealed/audited snapshot. It must digest the selected corpus
# bytes plus calendar and partition-source sidecars; leave blank for a mutable
# recorder corpus.
ALPACA_RESEARCH_IMMUTABLE_SOURCE_IDENTITY=
# Systemd installation path. Compose sets its own /app path in compose.yaml.
ALPACA_RESEARCH_PREPROCESSING_CACHE_ROOT=/opt/alpaca-agent-trading/research/cache/preprocessing
# Keep disposable preprocessing output in the same rename-capable mount.
TMPDIR=/opt/alpaca-agent-trading/research/cache/tmp
# Historical catch-up can use the model without opening an authorizing lane.
ALPACA_FACTORY_DIAGNOSTIC_ONLY=0
ALPACA_FACTORY_DIAGNOSTIC_REPORT=/opt/alpaca-agent-trading/runtime/research/diagnostics/factory-%s-latest.json
# Calibration is an explicit promotion-boundary opt-in. Offline discovery and
# factory diagnostics still run when it is disabled, but shadow ingestion is
# reported as blocked until an operator sets this to 1.
ALPACA_RESEARCH_CALIBRATION_ENABLED=0
# Quote-schedule calibration is diagnostic and potentially expensive; enable
# it separately when a fresh artifact is intentionally being measured.
ALPACA_RESEARCH_STRESS_CALIBRATION_ENABLED=0
# Fresh Compose installs may have no paper execution journal.  Bootstrap is
# explicitly marked ``bootstrap_unknown`` (authorization_exit_code=2) and
# cannot claim measured calibration or authorize production. It is consulted
# only when ALPACA_RESEARCH_CALIBRATION_ENABLED=1. Set to 0 to require a
# measured calibration report before shadow ingestion.
ALPACA_RESEARCH_CALIBRATION_BOOTSTRAP_UNKNOWN=1
# The systemd unit reads this separate provider dotenv and fails closed when
# it is absent, unreadable, or missing the configured provider key.
ALPACA_RESEARCH_LLM_SECRETS_FILE=/etc/alpaca-agent-trading/research-llm.env
