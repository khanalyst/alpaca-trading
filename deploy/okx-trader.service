# Stateful single-process trading loop with a local SQLite journal.
[Unit]
Description=OKX AI Trading Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=okx
WorkingDirectory=/opt/okx-agent-crypto
ExecStart=/opt/okx-agent-crypto/.venv/bin/python /opt/okx-agent-crypto/main.py run
Restart=on-failure
RestartSec=30
# A crash loop must not silently burn LLM budget.
StartLimitBurst=5
StartLimitIntervalSec=600
StandardOutput=journal
StandardError=journal
TimeoutStopSec=2m

[Install]
WantedBy=multi-user.target
